{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [
    "-Wall",
    "-Wextra",
    "-g3",
    "${fileDirname}\\*.cpp", // <-- Changed from "${file}"
    "-o",
    "${fileDirname}\\output\\main.exe"
],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/gusta/OneDrive/Documents/TFIA2/TP2",
      "program": "c:/Users/gusta/OneDrive/Documents/TFIA2/TP2/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}